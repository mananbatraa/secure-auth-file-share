# Copy to .env for local runs. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fileshare
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=fileshare
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_CREATE_BUCKET=true
MAX_UPLOAD_BYTES=52428800
# Presigned-POST uploads go straight to S3, so they can be larger
DIRECT_UPLOAD_MAX_BYTES=5368709120
UPLOAD_INTENT_TTL_SECONDS=900

# Email verification. Without SMTP_HOST the email is only logged.
REQUIRE_VERIFIED_EMAIL=true
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email?token={token}
EMAIL_VERIFICATION_TTL_SECONDS=86400
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Secure File Share <no-reply@localhost>

# Background cleanup worker (python -m app.cleanup)
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_BATCH_SIZE=500
CLEANUP_UPLOAD_GRACE_SECONDS=3600
CLEANUP_RETENTION_SECONDS=604800

OAUTH_REDIRECT_BASE_URL=http://localhost:8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
